{
  "name": "pramaan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e:demo": "playwright test -c test/e2e/playwright.config.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run e2e:demo",
    "demo": "node fixtures/demo-hrms/server.mjs",
    "doctor": "tsx src/cli/index.ts doctor",
    "llm:smoke": "tsx scripts/llm-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@faker-js/faker": "^10.6.0",
    "@inquirer/prompts": "^8.7.3",
    "commander": "^15.0.0",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "p-limit": "^7.3.3",
    "pino": "^10.4.0",
    "ts-morph": "^28.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
